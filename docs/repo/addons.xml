<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="repository.splitflap" name="Split-Flap Repository" version="1.0.0" provider-name="asm0dey">
  <extension point="xbmc.addon.repository">
    <dir>
      <info compressed="false">https://asm0dey.github.io/kodi-splitflap/repo/addons.xml</info>
      <checksum>https://asm0dey.github.io/kodi-splitflap/repo/addons.xml.md5</checksum>
      <datadir zip="true">https://asm0dey.github.io/kodi-splitflap/repo</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Install and update the Split-Flap Board screensaver and its glyph packs</summary>
    <description lang="en_GB">Adds the Split-Flap Board screensaver and its glyph packs to your add-on browser, so they install and update the same way any other add-on does -- no zip files, and no typing a URL with a remote.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/asm0dey/kodi-splitflap</source>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon><addon id="resource.images.splitflap.nimbus-ru" name="Split-Flap - Nimbus, Latin + Cyrillic" version="1.0.1" provider-name="splitflap">
  <requires>
    <import addon="kodi.resource" version="1.0.0" />
  </requires>
  <extension point="kodi.resource.images" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Glyph pack for Split-Flap Board</summary>
    <description lang="en_GB">Split-Flap - Nimbus, Latin + Cyrillic</description>
    <platform>all</platform>
  </extension>
</addon><addon id="screensaver.splitflap" name="Split-Flap Board" version="0.1.15" provider-name="finkel">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  <extension point="xbmc.ui.screensaver" library="default.py" />
  <extension point="xbmc.python.script" library="chooser.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">A mechanical split-flap departure board</summary>
    <description lang="en_GB">Renders a Solari-style split-flap board showing phrases, the time, and the weather. Characters flap through the drum exactly as the hardware does.</description>
    <license>GPL-2.0-or-later</license>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon><addon id="script.splitflap.source.recentlyadded" name="Split-Flap — Recently Added" version="0.1.1" provider-name="finkel">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  
  <extension point="xbmc.python.script" library="default.py" name="Split-Flap — Recently Added">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.python.module" library="." />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Latest library additions for the Split-Flap Board</summary>
    <description lang="en_GB">Supplies the Split-Flap Board screensaver with the newest additions to Kodi's video library — movies and episodes merged newest-first, one per board. Set the screensaver's Show setting to Add-on to use it.</description>
    <license>GPL-2.0-or-later</license>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon></addons>