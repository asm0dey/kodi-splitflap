[
  {
    "label": "pytest: layout tests",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "args": ["tests/test_layout.py", "-q"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "justMyCode": false
  },
  {
    "label": "pytest: test under cursor",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "args": ["$ZED_FILE::$ZED_SYMBOL", "-q"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "justMyCode": false
  },
  {
    "label": "pytest: whole suite",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "args": ["-q"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "justMyCode": false
  },
  {
    "label": "python: current file",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
